<?xml version="1.0" encoding="UTF-8"?>
<extentreports>
    <configuration>
        <!-- report theme -->
        <theme>standard</theme>
        
        <!-- document encoding -->
        <encoding>UTF-8</encoding>
        
        <!-- protocol for script and stylesheets -->
        <protocol>https</protocol>
        
        <!-- title of the document -->
        <documentTitle>SurePay Blog API Test Report</documentTitle>
        
        <!-- report name - displayed at top-nav -->
        <reportName>SurePay API Automation Results</reportName>
        
        <!-- global date format override -->
        <dateFormat>MMM dd, yyyy HH:mm:ss</dateFormat>
        
        <!-- global time format override -->
        <timeFormat>HH:mm:ss</timeFormat>
        
        <!-- custom javascript -->
        <scripts>
            <![CDATA[
                $(document).ready(function() {
                    
                });
            ]]>
        </scripts>
        
        <!-- custom styles -->
        <styles>
            <![CDATA[
                .test-name {
                    color: #2E86AB;
                }
            ]]>
        </styles>
    </configuration>
</extentreports>